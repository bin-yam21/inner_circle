//@version=6
strategy("ICT 2022 Clean Entry Bot — Confirmed",
     overlay=true,
     pyramiding=0,
     initial_capital=1000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     max_labels_count=300,
     max_lines_count=50,
     max_boxes_count=10)

//====================================================
// 1. INPUTS
//====================================================
string groupSetup = "ICT Setup"
int swingLen = input.int(3, "Swing strength", minval=1, maxval=10, group=groupSetup)
int sweepExpiry = input.int(12, "Maximum bars: sweep to MSS", minval=1, group=groupSetup)
int fvgExpiry = input.int(8, "Maximum bars: MSS to FVG", minval=1, group=groupSetup)
bool useHTFBias = input.bool(true, "Use higher timeframe bias", group=groupSetup)
string biasTF = input.timeframe("60", "Bias timeframe", group=groupSetup)
int emaLen = input.int(50, "Higher timeframe EMA", minval=1, group=groupSetup)

string groupRisk = "Risk Management"
float rr = input.float(2.0, "Take profit in R", minval=1.0, step=0.5, group=groupRisk)
int atrLen = input.int(14, "ATR length", minval=1, group=groupRisk)
float atrBuffer = input.float(0.2, "SL buffer (ATR)", minval=0.0, step=0.1, group=groupRisk)
bool allowLong = input.bool(true, "Enable LONG", group=groupRisk)
bool allowShort = input.bool(true, "Enable SHORT", group=groupRisk)

string groupVisual = "Chart Display"
bool showSweep = input.bool(true, "Show valid setup's sweep", group=groupVisual)
bool showMSS = input.bool(true, "Show MSS", group=groupVisual)
bool showFVG = input.bool(true, "Show latest qualifying FVG only", group=groupVisual)
bool showLevels = input.bool(true, "Show Entry / SL / TP", group=groupVisual)
bool showDashboard = input.bool(true, "Show dashboard", group=groupVisual)

//====================================================
// 2. HIGHER-TIMEFRAME BIAS
// Use only the previous completed HTF candle.
//====================================================
float htfClose = request.security(
     syminfo.tickerid, biasTF, close[1],
     lookahead=barmerge.lookahead_on)

float htfEMA = request.security(
     syminfo.tickerid, biasTF, ta.ema(close, emaLen)[1],
     lookahead=barmerge.lookahead_on)

bool bullishBias = not useHTFBias or htfClose > htfEMA
bool bearishBias = not useHTFBias or htfClose < htfEMA

//====================================================
// 3. CONFIRMED SWING LEVELS
//====================================================
float pivotHigh = ta.pivothigh(high, swingLen, swingLen)
float pivotLow = ta.pivotlow(low, swingLen, swingLen)

var float swingHigh = na
var float swingLow = na

if not na(pivotHigh)
    swingHigh := pivotHigh

if not na(pivotLow)
    swingLow := pivotLow

//====================================================
// 4. LIQUIDITY SWEEPS
// Low sweep: price pierces a swing low and closes back above.
// High sweep: price pierces a swing high and closes back below.
// Labels are added only if the complete setup qualifies.
//====================================================
bool sweepSSL = barstate.isconfirmed and
     not na(swingLow) and low < swingLow and close > swingLow

bool sweepBSL = barstate.isconfirmed and
     not na(swingHigh) and high > swingHigh and close < swingHigh

var bool waitBullMSS = false
var bool waitBearMSS = false
var int bullSweepIndex = na
var int bearSweepIndex = na
var float bullSweepLow = na
var float bearSweepHigh = na
var float bullBreakLevel = na
var float bearBreakLevel = na

var bool waitBullFVG = false
var bool waitBearFVG = false
var int bullMSSIndex = na
var int bearMSSIndex = na
var float longSLAnchor = na
var float shortSLAnchor = na

if sweepSSL and not na(swingHigh)
    waitBullMSS := true
    waitBearMSS := false
    bullSweepIndex := bar_index
    bullSweepLow := low
    bullBreakLevel := swingHigh
    waitBullFVG := false
    waitBearFVG := false

if sweepBSL and not na(swingLow) 
    waitBearMSS := true
    waitBullMSS := false
    bearSweepIndex := bar_index
    bearSweepHigh := high
    bearBreakLevel := swingLow
    waitBullFVG := false
    waitBearFVG := false

// Expire old sweep setups.
if waitBullMSS and bar_index - bullSweepIndex > sweepExpiry
    waitBullMSS := false

if waitBearMSS and bar_index - bearSweepIndex > sweepExpiry
    waitBearMSS := false

//====================================================
// 5. MARKET STRUCTURE SHIFT
// MSS must occur after the sweep, not on the same candle.
//====================================================
bool bullMSS = barstate.isconfirmed and waitBullMSS and
     bar_index > bullSweepIndex and
     close > bullBreakLevel and close > open

bool bearMSS = barstate.isconfirmed and waitBearMSS and
     bar_index > bearSweepIndex and
     close < bearBreakLevel and close < open

if bullMSS
    waitBullMSS := false
    waitBearFVG := false
    waitBullFVG := true
    bullMSSIndex := bar_index
    longSLAnchor := bullSweepLow

if bearMSS
    waitBearMSS := false
    waitBullFVG := false
    waitBearFVG := true
    bearMSSIndex := bar_index
    shortSLAnchor := bearSweepHigh

// Expire if no qualifying FVG appears in time.
if waitBullFVG and bar_index - bullMSSIndex > fvgExpiry
    waitBullFVG := false

if waitBearFVG and bar_index - bearMSSIndex > fvgExpiry
    waitBearFVG := false

//====================================================
// 6. FAIR VALUE GAP
// Only FVGs after the corresponding confirmed MSS qualify.
//====================================================
bool bullFVG = bar_index >= 2 and low > high[2]
bool bearFVG = bar_index >= 2 and high < low[2]

float atr = ta.atr(atrLen)
bool flat = strategy.position_size == 0

bool longSetup = barstate.isconfirmed and flat and allowLong and
     bullishBias and waitBullFVG and
     bar_index > bullMSSIndex and bullFVG

bool shortSetup = barstate.isconfirmed and flat and allowShort and
     bearishBias and waitBearFVG and
     bar_index > bearMSSIndex and bearFVG

//====================================================
// 7. ENTRY, SL, TP AND ALERTS
// Entry is the confirmed FVG candle's closing price.
//====================================================
var float entryPrice = na
var float stopPrice = na
var float targetPrice = na

var string lastSignal = "NONE"
var string lastResult = "No closed trade"
var int closedTradesSeen = 0

var box latestFVGBox = na

bool newLong = false
bool newShort = false

// Update the last completed trade result.
if strategy.closedtrades > closedTradesSeen
    int lastTrade = strategy.closedtrades - 1
    float profit = strategy.closedtrades.profit(lastTrade)

    lastResult := profit > 0 ? "WIN" :
         profit < 0 ? "LOSS" : "BREAKEVEN"

    closedTradesSeen := strategy.closedtrades

    entryPrice := na
    stopPrice := na
    targetPrice := na

//---------------- LONG ----------------
if longSetup
    float proposedEntry = close
    float proposedSL = longSLAnchor - atr * atrBuffer
    float risk = proposedEntry - proposedSL

    if risk > syminfo.mintick
        entryPrice := proposedEntry
        stopPrice := proposedSL
        targetPrice := proposedEntry + risk * rr
        lastSignal := "LONG"
        newLong := true

        strategy.entry("LONG", strategy.long)
        strategy.exit("LONG EXIT", from_entry="LONG",
             stop=stopPrice, limit=targetPrice)

        // Draw only the sweep and MSS for this qualifying setup.
        if showSweep
            label.new(bullSweepIndex, bullSweepLow, "SSL SWEEP",
                 xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_up,
                 color=color.aqua, textcolor=color.black, size=size.tiny)

        if showMSS
            label.new(bullMSSIndex, bullBreakLevel, "BULL MSS",
                 xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_down,
                 color=color.green, textcolor=color.white, size=size.tiny)

        if showFVG
            if not na(latestFVGBox)
                box.delete(latestFVGBox)

            latestFVGBox := box.new(
                 left=bar_index - 2, top=low,
                 right=bar_index + 8, bottom=high[2],
                 xloc=xloc.bar_index,
                 bgcolor=color.new(color.lime, 85),
                 border_color=color.lime,
                 text="ENTRY FVG",
                 text_color=color.white,
                 text_size=size.tiny)

        label.new(bar_index, low,
             "LONG\nEntry: " + str.tostring(entryPrice, format.mintick) +
             "\nSL: " + str.tostring(stopPrice, format.mintick) +
             "\nTP: " + str.tostring(targetPrice, format.mintick),
             style=label.style_label_up,
             color=color.green, textcolor=color.white, size=size.small)

        alert("ICT LONG | " + syminfo.ticker +
             " | TF: " + timeframe.period +
             " | Entry: " + str.tostring(entryPrice, format.mintick) +
             " | SL: " + str.tostring(stopPrice, format.mintick) +
             " | TP: " + str.tostring(targetPrice, format.mintick),
             alert.freq_once_per_bar_close)

        waitBullFVG := false

//---------------- SHORT ----------------
if shortSetup
    float proposedEntry = close
    float proposedSL = shortSLAnchor + atr * atrBuffer
    float risk = proposedSL - proposedEntry

    if risk > syminfo.mintick
        entryPrice := proposedEntry
        stopPrice := proposedSL
        targetPrice := proposedEntry - risk * rr
        lastSignal := "SHORT"
        newShort := true

        strategy.entry("SHORT", strategy.short)
        strategy.exit("SHORT EXIT", from_entry="SHORT",
             stop=stopPrice, limit=targetPrice)

        if showSweep
            label.new(bearSweepIndex, bearSweepHigh, "BSL SWEEP",
                 xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_down,
                 color=color.orange, textcolor=color.black, size=size.tiny)

        if showMSS
            label.new(bearMSSIndex, bearBreakLevel, "BEAR MSS",
                 xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_up,
                 color=color.red, textcolor=color.white, size=size.tiny)

        if showFVG
            if not na(latestFVGBox)
                box.delete(latestFVGBox)

            latestFVGBox := box.new(
                 left=bar_index - 2, top=low[2],
                 right=bar_index + 8, bottom=high,
                 xloc=xloc.bar_index,
                 bgcolor=color.new(color.red, 85),
                 border_color=color.red,
                 text="ENTRY FVG",
                 text_color=color.white,
                 text_size=size.tiny)

        label.new(bar_index, high,
             "SHORT\nEntry: " + str.tostring(entryPrice, format.mintick) +
             "\nSL: " + str.tostring(stopPrice, format.mintick) +
             "\nTP: " + str.tostring(targetPrice, format.mintick),
             style=label.style_label_down,
             color=color.red, textcolor=color.white, size=size.small)

        alert("ICT SHORT | " + syminfo.ticker +
             " | TF: " + timeframe.period +
             " | Entry: " + str.tostring(entryPrice, format.mintick) +
             " | SL: " + str.tostring(stopPrice, format.mintick) +
             " | TP: " + str.tostring(targetPrice, format.mintick),
             alert.freq_once_per_bar_close)

        waitBearFVG := false

//====================================================
// 8. TRADE LEVELS
//====================================================
bool activeTrade = strategy.position_size != 0
bool displayLevels = showLevels and (activeTrade or newLong or newShort)

plot(displayLevels ? entryPrice : na, "Entry",
     color=color.white, linewidth=2, style=plot.style_linebr)

plot(displayLevels ? stopPrice : na, "Stop Loss",
     color=color.red, linewidth=2, style=plot.style_linebr)

plot(displayLevels ? targetPrice : na, "Take Profit",
     color=color.lime, linewidth=2, style=plot.style_linebr)

//====================================================
// 9. STATUS DASHBOARD
//====================================================
var table dashboard = table.new(position.top_right, 2, 6, border_width=1)

string setupStatus = activeTrade ? "TRADE ACTIVE" :
     waitBullMSS ? "WAITING BULL MSS" :
     waitBearMSS ? "WAITING BEAR MSS" :
     waitBullFVG ? "WAITING BULL FVG" :
     waitBearFVG ? "WAITING BEAR FVG" : "WAITING SWEEP"

string biasStatus = not useHTFBias ? "FILTER OFF" :
     bullishBias ? "BULLISH" :
     bearishBias ? "BEARISH" : "NEUTRAL"

if barstate.islast and showDashboard
    table.cell(dashboard, 0, 0, "ICT 2022",
         bgcolor=color.navy, text_color=color.white)
    table.cell(dashboard, 1, 0, "STATUS",
         bgcolor=color.navy, text_color=color.white)

    table.cell(dashboard, 0, 1, "HTF Bias")
    table.cell(dashboard, 1, 1, biasStatus)

    table.cell(dashboard, 0, 2, "Setup")
    table.cell(dashboard, 1, 2, setupStatus)

    table.cell(dashboard, 0, 3, "Last Signal")
    table.cell(dashboard, 1, 3, lastSignal)

    table.cell(dashboard, 0, 4, "Last Result")
    table.cell(dashboard, 1, 4, activeTrade ? "OPEN" : lastResult)

    table.cell(dashboard, 0, 5, "Chart")
    table.cell(dashboard, 1, 5, syminfo.ticker + " / " + timeframe.period)